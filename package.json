{
  "name": "ontocode-extension",
  "displayName": "OntoCode OWL Editor",
  "description": "Edit OWL files with authentication and web-based interface",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Languages",
    "Formatters"
  ],
  "keywords": [
    "owl",
    "ontology",
    "semantic web",
    "rdf",
    "knowledge graph"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "webviews": [
      {
        "viewType": "ontocodeEditor",
        "displayName": "OntoCode Editor",
        "when": "true"
      }
    ],
    "commands": [
      {
        "command": "ontocode.edit",
        "title": "Edit with OntoCode",
        "category": "OntoCode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ontocode.edit",
          "when": "resourceExtname == .owl"
        }
      ],
      "explorer/context": [
        {
          "command": "ontocode.edit",
          "when": "resourceExtname == .owl",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "owl",
        "aliases": [
          "OWL",
          "owl"
        ],
        "extensions": [
          ".owl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "owl",
        "scopeName": "text.xml.owl",
        "path": "./syntaxes/owl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build-webview": "cd webview && npm run build",
    "dev-webview": "cd webview && npm run start"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "fs-extra": "^11.1.0",
    "lucide-react": "^0.525.0"
  }
}
